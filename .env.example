# =============================================================================
#  Variables de entorno del portal — copiar a .env.local y rellenar.
#  .env.local está en .gitignore (nunca se sube).
# =============================================================================

# --- Base de datos operacional (Postgres) --------------------------------------
# Local:  postgres://USER@localhost:5432/oakberry_portal
# Neon:   postgres://USER:PASS@ep-xxx.neon.tech/oakberry_portal?sslmode=require
# CloudSQL: usar el Cloud SQL Auth Proxy o la IP privada + sslmode=require
DATABASE_URL=postgres://daniel@localhost:5432/oakberry_portal

# --- Modo dev sin Firebase (para correr local sin auth real) -------------------
# Con AUTH_MODE=dev, la app asume este usuario/rol y NO exige login.
# En pruebas/prod usar AUTH_MODE=firebase (ver README, Fase 1).
AUTH_MODE=dev
DEV_USER_EMAIL=dzuluaga@manelfoods.com
DEV_USER_ROL=admin

# --- Firebase Auth (Fase 1 — pruebas/prod) -------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
