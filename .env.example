# =============================================================================
#  Variables de entorno del portal — copiar a .env.local y rellenar.
#  .env.local está en .gitignore (nunca se sube).
# =============================================================================

# --- Base de datos operacional (Postgres) --------------------------------------
# Local:  postgres://USER@localhost:5432/oakberry_portal
# Neon:   postgres://USER:PASS@ep-xxx.neon.tech/oakberry_portal?sslmode=require
# CloudSQL: usar el Cloud SQL Auth Proxy o la IP privada + sslmode=require
DATABASE_URL=postgres://daniel@localhost:5432/oakberry_portal

# --- Modo de auth --------------------------------------------------------------
# AUTH_MODE=dev    -> usuario fijo, SIN login (solo local).
# AUTH_MODE=google -> login real con Google (Auth.js). Usar en pruebas/prod.
AUTH_MODE=dev

# Solo aplica con AUTH_MODE=dev:
DEV_USER_EMAIL=dzuluaga@manelfoods.com
DEV_USER_ROL=admin

# --- Auth.js / Google (Opción A — EN USO; aplica con AUTH_MODE=google) ----------
# AUTH_SECRET: generar con `openssl rand -base64 32`
AUTH_SECRET=
# Credenciales del cliente OAuth web (Google Cloud → Credenciales):
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Compuerta de acceso: dominio corporativo + correos extra (coma-separados)
AUTH_ALLOWED_DOMAIN=manelfoods.com
AUTH_ALLOWED_EMAILS=fabian@centillion.com.co
# Rol por defecto si el correo aún no está en la tabla `usuarios`
AUTH_DEFAULT_ROL=conciliador
# En Vercel/prod: host público exacto (de ahí sale el redirect_uri). Local: omitir.
AUTH_URL=https://www.manelfoods.co
AUTH_TRUST_HOST=true

# --- Opción B (futuro) — Firebase Auth -----------------------------------------
# Alternativa para multi-tenant/SaaS. No cambia la app (siempre getCurrentUser()).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
